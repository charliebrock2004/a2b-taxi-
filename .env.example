# Copy to .env.local for local work; set the same names in Vercel > Settings > Environment Variables.

# Public address of this deployment, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Leave unset while this is a concept. Set to "true" ONLY once the owner has approved it and it
# is the official site: that allows search engines to index it and removes the concept notice.
SITE_LIVE=

# Enquiry form delivery (Resend, https://resend.com). Until all three are set the form tells
# visitors to phone instead and sends nothing.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
